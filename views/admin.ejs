<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Админ-панель управления пропусками">
    <meta name="theme-color" content="#3498db">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <title>Админ-панель</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <div class="header-top">
                <h1>🔧 Админ-панель</h1>
                <a href="/admin-logout" class="btn btn-danger">Выход</a>
            </div>
            <p class="subtitle">Управление пропусками</p>
        </header>

        <main class="main-content">
            <!-- Добавление пропуска -->
            <section class="section add-absence-section">
                <h2>➕ Добавить пропуск</h2>
                
                <!-- Способ 1: Добавить одного человека на дату -->
                <div style="margin-bottom: 20px;">
                    <h3 style="font-size: 16px; margin-bottom: 10px;">📅 Добавить одного человека:</h3>
                    <form id="absenceForm" class="form">
                        <div class="form-group">
                            <label for="name">Выберите человека:</label>
                            <select id="name" name="name" required>
                                <option value="">-- Выберите --</option>
                                <% friends.forEach(friend => { %>
                                    <option value="<%= friend %>"><%= friend %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="date">Дата сбора:</label>
                            <input type="date" id="date" name="date" required>
                        </div>

                        <button type="submit" class="btn btn-primary">Добавить пропуск</button>
                        <span id="formMessage" class="message"></span>
                    </form>
                </div>

                <!-- Способ 2: Добавить нескольких человек на одну дату -->
                <div style="border-top: 2px solid #ecf0f1; padding-top: 20px;">
                    <h3 style="font-size: 16px; margin-bottom: 10px;">👥 Добавить нескольких человек на дату:</h3>
                    <form id="bulkAbsenceForm" class="form">
                        <div class="form-group">
                            <label for="bulkDate">Дата сбора:</label>
                            <input type="date" id="bulkDate" name="bulkDate" required>
                        </div>

                        <div class="form-group">
                            <label>Выберите отсутствующих:</label>
                            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-top: 10px;">
                                <% friends.forEach(friend => { %>
                                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; padding: 8px; background: #f8f9fa; border-radius: 6px;">
                                        <input type="checkbox" name="selectedFriends" value="<%= friend %>" style="cursor: pointer;">
                                        <span><%= friend %></span>
                                    </label>
                                <% }); %>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">Добавить отсутствующих</button>
                        <span id="bulkFormMessage" class="message"></span>
                    </form>
                </div>
            </section>

            <!-- Управление пропусками -->
            <section class="section management-section">
                <h2>📋 Управление пропусками</h2>
                
                <% if (absences.length === 0) { %>
                    <p class="empty-message">Нет записей о пропусках</p>
                <% } else { %>
                    <div class="admin-list">
                        <% stats.forEach(stat => { %>
                            <% if (stat.totalAbsences > 0) { %>
                                <div class="admin-item">
                                    <button type="button" class="admin-button" onclick="toggleAdminDates(this, '<%= stat.name %>')">
                                        <span class="admin-name"><%= stat.name %></span>
                                        <span class="admin-count"><%= stat.totalAbsences %> раз</span>
                                        <span class="admin-sum">💰 <%= stat.totalDebtAmount %> тг</span>
                                        <% if (stat.paidAmount > 0) { %>
                                            <span class="paid-badge">✅ Туланди <%= stat.paidAmount %> тг</span>
                                        <% } %>
                                        <% if (stat.overpayment > 0) { %>
                                            <span class="paid-badge" style="background: #f1c40f; color: #000;">⚠️ Ортиқча <%= stat.overpayment %> тг</span>
                                        <% } %>
                                        <span class="toggle-icon">▼</span>
                                    </button>
                                    <div class="admin-dates" style="display: none;">
                                        <ul class="admin-dates-list">
                                            <% const personAbsences = absences.filter(a => a.name === stat.name).sort((a, b) => new Date(b.date) - new Date(a.date)); %>
                                            <% personAbsences.forEach(absence => { %>
                                                <li class="admin-date-item">
                                                    <span class="date-value"><%= new Date(absence.date + 'T00:00:00').toLocaleDateString('ru-RU', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                                                    <span class="amount">2000 тг</span>
                                                    <button type="button" class="btn btn-small btn-danger" onclick="removeAbsence('<%= absence.name %>', '<%= absence.date %>')">Удалить</button>
                                                </li>
                                            <% }); %>
                                        </ul>
                                    </div>
                                </div>
                            <% } %>
                        <% }); %>
                    </div>
                <% } %>
            </section>

            <!-- Добавить долг напрямую -->
            <section class="section add-debt-section">
                <h2>💳 Добавить долг напрямую</h2>
                <form id="debtForm" class="form">
                    <div class="form-group">
                        <label for="debtName">Выберите человека:</label>
                        <select id="debtName" name="debtName" required>
                            <option value="">-- Выберите --</option>
                            <% friends.forEach(friend => { %>
                                <option value="<%= friend %>"><%= friend %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="debtAmount">Сумма долга (тг):</label>
                        <input type="number" id="debtAmount" name="debtAmount" min="1" placeholder="Введите сумму" required>
                    </div>

                    <div class="form-group">
                        <label for="debtComment">Комментарий/описание:</label>
                        <input type="text" id="debtComment" name="debtComment" placeholder="Например: От другого события..." required>
                    </div>

                    <button type="submit" class="btn btn-primary">Добавить долг</button>
                    <span id="debtMessage" class="message"></span>
                </form>

                <!-- История прямого долга -->
                <div style="margin-top: 20px; border-top: 2px solid #ecf0f1; padding-top: 20px;">
                    <h3 style="font-size: 16px; margin-bottom: 10px;">📋 История прямого долга:</h3>
                    <% if (debts && debts.length === 0) { %>
                        <p class="empty-message">Нет прямого долга</p>
                    <% } else { %>
                        <div class="debts-list">
                            <% debts.forEach((debt, index) => { %>
                                <div class="debt-item">
                                    <div class="debt-header">
                                        <span class="debt-name">👤 <%= debt.name %></span>
                                        <span class="debt-amount">💰 <%= debt.amount %> тг</span>
                                        <span class="debt-date"><%= debt.date %></span>
                                    </div>
                                    <div class="debt-comment">📝 <%= debt.comment %></div>
                                    <button type="button" class="btn btn-small btn-danger" onclick="removeDebt('<%= index %>')">Удалить</button>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- Финансовый отчет -->
            <section class="section total-section">
                <h2>💵 Финансовый отчет</h2>
                <div class="total-info">
                    <div class="total-card total-debt">
                        <div class="total-label">Общий долг:</div>
                        <div class="total-value"><%= totalDebt %> тг</div>
                    </div>
                    <div class="total-card paid-count">
                        <div class="total-label">Оплачено:</div>
                        <div class="total-value"><%= totalPaid %> тг</div>
                    </div>
                </div>
            </section>

            <!-- Управление кассой -->
            <section class="section cash-section">
                <h2>💳 Касса (управление платежами)</h2>
                
                <div class="cash-add">
                    <form id="paymentForm" class="form">
                        <div class="form-group">
                            <label for="paymentName">Выберите человека:</label>
                            <select id="paymentName" name="paymentName" required>
                                <option value="">-- Выберите --</option>
                                <% stats.forEach(stat => { %>
                                    <option value="<%= stat.name %>"><%= stat.name %> (Долг: <%= stat.totalDebtAmount %> тг, оплачено: <%= stat.paidAmount %> тг)</option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="paymentAmount">Сумма платежа (тг):</label>
                            <input type="number" id="paymentAmount" name="amount" min="1" placeholder="Введите сумму" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Добавить платеж</button>
                        <span id="paymentMessage" class="message"></span>
                    </form>
                </div>

                <% if (payments.length === 0) { %>
                    <p class="empty-message">Никто еще не оплатил</p>
                <% } else { %>
                    <div class="payments-list">
                        <% payments.forEach((payment, index) => { %>
                            <div class="payment-item">
                                <span class="payment-name">✅ <%= payment.name %></span>
                                <span class="payment-amount"><%= payment.amount %> тг</span>
                                <span class="payment-detail">(<%= payment.date %>)</span>
                                <button type="button" class="btn btn-small btn-danger" onclick="removePayment('<%= index %>')">Удалить</button>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </section>

            <!-- Управление расходами -->
            <section class="section expense-section">
                <h2>💰 Управление расходами</h2>
                
                <div class="expense-add">
                    <form id="expenseForm" class="form">
                        <div class="form-group">
                            <label for="expenseAmount">Сумма расхода (тг):</label>
                            <input type="number" id="expenseAmount" name="amount" min="1" placeholder="Введите сумму" required>
                        </div>
                        <div class="form-group">
                            <label for="expenseComment">Комментарий/Описание:</label>
                            <textarea id="expenseComment" name="comment" placeholder="Например: Аренда сала, напитки..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Добавить расход</button>
                        <span id="expenseMessage" class="message"></span>
                    </form>
                </div>

                <div class="financial-summary">
                    <div class="summary-card">
                        <div class="summary-label">Нужно собрать:</div>
                        <div class="summary-value"><%= totalDebt %> тг</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-label">Оплачено:</div>
                        <div class="summary-value"><%= totalPaid %> тг</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-label">Расходы:</div>
                        <div class="summary-value"><%= totalExpenses %> тг</div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-label">В кассе:</div>
                        <div class="summary-value"><%= cashBalance %> тг</div>
                    </div>
                </div>

                <% if (expenses.length === 0) { %>
                    <p class="empty-message">Нет расходов</p>
                <% } else { %>
                    <div class="expenses-list">
                        <% expenses.forEach((expense, index) => { %>
                            <div class="expense-item">
                                <div class="expense-header">
                                    <span class="expense-amount">💸 <%= expense.amount %> тг</span>
                                    <span class="expense-date"><%= expense.date || 'Без даты' %></span>
                                </div>
                                <div class="expense-comment"><%= expense.comment %></div>
                                <button type="button" class="btn btn-small btn-danger" onclick="removeExpense('<%= index %>')">Удалить</button>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </section>

            <!-- Экспорт данных -->
            <section class="section export-section">
                <h2>📥 Экспорт данных</h2>
                <a href="/export-csv" class="btn btn-secondary">Скачать CSV</a>
            </section>

            <!-- Полная очистка штрафов и оплат -->
            <section class="section clear-section" style="margin-top:18px;">
                <h2>⚠️ Полная очистка</h2>
                <p>Кнопка ниже удалит все записи о штрафах (пропусках), всех оплатах и расходах. Эта операция необратима.</p>
                <p>Для подтверждения введите код администратора <strong>8888</strong> при запросе.</p>
                <button type="button" class="btn btn-danger" onclick="clearPenaltiesPayments()">Удалить все штрафы, оплаты и расходы</button>
            </section>
        </main>
    </div>

    <script src="/js/app.js"></script>
    
    <!-- Service Worker регистрация для PWA -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/js/sw.js')
                    .then((registration) => {
                        console.log('Service Worker зарегистрирован:', registration);
                        setInterval(() => {
                            registration.update();
                        }, 24 * 60 * 60 * 1000);
                    })
                    .catch((error) => {
                        console.log('Service Worker ошибка регистрации:', error);
                    });
            });
        }
    </script>
</body>
</html>

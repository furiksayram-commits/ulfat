<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Отслеживание пропусков и долгов для группы Улфатлар">
    <meta name="theme-color" content="#3498db">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Чойхона">
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" href="/icons/icon-192x192.png">
    <title>Чойхона</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <h1>📊 Чойхона</h1>
            <p class="subtitle">Группа 13 Улфатлар</p>
        </header>

        <main class="main-content">
            <!-- Таблица всех людей -->
            <section class="section all-people-section">
                <h2>👥Список</h2>
                <div class="people-table">
                    <div class="table-header">
                        <div class="table-cell">Исми</div>
                        <div class="table-cell">Кемаган</div>
                        <div class="table-cell">Сумма</div>
                        <div class="table-cell">Туланди</div>
                        <div class="table-cell">Статус</div>
                    </div>
                    <% stats.forEach(stat => { %>
                        <div class="table-row <% if (stat.totalAbsences === 0) { %>no-absence<% } %> <% if (stat.remainingDebt === 0) { %>all-paid<% } %>">
                            <div class="table-cell table-name"><%= stat.name %></div>
                            <div class="table-cell"><%= stat.totalAbsences %></div>
                            <div class="table-cell"><%= stat.totalDebtAmount %> тг</div>
                            <div class="table-cell"><%= stat.paidAmount %> тг</div>
                            <div class="table-cell"><% if (stat.remainingDebt > 0) { %><%= stat.remainingDebt %> тг<% } else if (stat.overpayment > 0) { %>+<%= stat.overpayment %> тг<% } else { %>✅ Оплачено<% } %></div>
                        </div>
                    <% }); %>
                </div>
            </section>

            <!-- История пропусков по людям -->
            <section class="section history-section">
                <h2>📅 История </h2>
                
                <% if (stats.length === 0) { %>
                    <p class="empty-message">Пока нет записей о пропусках</p>
                <% } else { %>
                    <div class="history-list">
                        <% stats.forEach(stat => { %>
                            <% if (stat.totalAbsences > 0) { %>
                                <div class="history-item">
                                    <button type="button" class="history-button" onclick="toggleDates(this, '<%= stat.name %>')">
                                        <span class="history-name"><%= stat.name %></span>
                                        <span class="history-count"><%= stat.totalAbsences %> раз</span>
                                        <span class="history-sum">💰 <%= stat.totalDebtAmount %> тг</span>
                                        <% if (stat.paidAmount > 0) { %>
                                            <span class="paid-badge">✅ Туланди <%= stat.paidAmount %> тг</span>
                                        <% } %>
                                        <% if (stat.overpayment > 0) { %>
                                            <span class="paid-badge" style="background: #f1c40f; color: #000;">⚠️ Ортиқча <%= stat.overpayment %> тг</span>
                                        <% } %>
                                        <span class="toggle-icon">▼</span>
                                    </button>
                                    <div class="history-dates" style="display: none;">
                                        <ul class="dates-list">
                                            <% const personAbsences = absences.filter(a => a.name === stat.name).sort((a, b) => new Date(b.date) - new Date(a.date)); %>
                                            <% personAbsences.forEach(absence => { %>
                                                <li class="date-item">
                                                    <span class="date-value"><%= new Date(absence.date + 'T00:00:00').toLocaleDateString('ru-RU', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                                                    <span class="amount">2000 тг</span>
                                                </li>
                                            <% }); %>
                                        </ul>
                                    </div>
                                </div>
                            <% } %>
                        <% }); %>
                    </div>
                <% } %>
            </section>

            <!-- Итого по платежам -->
            <section class="section total-section">
                <h2>💵 Финансовый отчет</h2>
                <div class="total-info">
                    <div class="total-card total-debt">
                        <div class="total-label">Нужно собрать:</div>
                        <div class="total-value"><%= totalDebt %> тг</div>
                    </div>
                    <div class="total-card in-cash">
                        <div class="total-label">В кассе:</div>
                        <div class="total-value"><%= cashBalance %> тг</div>
                    </div>
                    <div class="total-card expenses-total">
                        <div class="total-label">Расходы:</div>
                        <div class="total-value"><%= totalExpenses %> тг</div>
                    </div>
                </div>

                <!-- Касса - кто оплатил -->
                <h3 class="cash-title">💳 Касса (список платежей)</h3>
                <% if (payments.length === 0) { %>
                    <p class="empty-message">Никто еще не оплатил</p>
                <% } else { %>
                    <div class="payments-list">
                        <% payments.forEach(payment => { %>
                            <div class="payment-item">
                                <span class="payment-name">✅ <%= payment.name %></span>
                                <span class="payment-amount"><%= payment.amount %> тг</span>
                                <span class="payment-detail">(<%= payment.date %>)</span>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </section>
        </main>

        <footer class="footer-links">
            <% if (isAdmin) { %>
                <a href="/admin" class="btn btn-primary btn-small">Админ-панель</a>
                <a href="/admin-logout" class="btn btn-danger btn-small">Выход</a>
            <% } else { %>
                <a href="/admin-login" class="btn btn-secondary btn-small">Катта Боллар</a>
            <% } %>
        </footer>
    </div>

    <script src="/js/app.js"></script>
    
    <!-- Service Worker регистрация для PWA -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/js/sw.js')
                    .then((registration) => {
                        console.log('Service Worker зарегистрирован:', registration);
                        
                        // Проверка обновлений каждые 24 часа
                        setInterval(() => {
                            registration.update();
                        }, 24 * 60 * 60 * 1000);
                    })
                    .catch((error) => {
                        console.log('Service Worker ошибка регистрации:', error);
                    });
                
                // Показать уведомление об установке
                if (window.matchMedia('(display-mode: standalone)').matches) {
                    console.log('Приложение установлено как PWA');
                }
            });
            
            // Обработка обновлений Service Worker
            navigator.serviceWorker.addEventListener('controllerchange', () => {
                console.log('Service Worker обновлен');
                // Опционально: показать уведомление пользователю о обновлении
            });
        }
        
        // Обработка установки на рабочий стол/домашний экран
        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            console.log('Приложение готово к установке');
            
            // Можно добавить кнопку "Установить" на странице
            // и вызвать deferredPrompt.prompt() когда пользователь нажмет на нее
        });
        
        window.addEventListener('appinstalled', () => {
            console.log('Приложение установлено');
            deferredPrompt = null;
        });
    </script>
</body>
</html>
